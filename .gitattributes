# Normalize line endings: LF in the repository and in the working tree.
#
# `lib/` is generated by scripts/build.mjs, which compares it to `src/` byte for
# byte. A CRLF checkout on Windows would make that check fail, and would ship
# CRLF into the published tarball.
* text=auto eol=lf

# Binary assets.
*.gif binary
*.png binary
*.jpg binary
*.ico binary

# Committed build output. Collapse it in GitHub's diff view so review noise stays
# on `src/`, but keep it diffable — a reviewer should still be able to see
# exactly what shipped.
lib/** linguist-generated=true
